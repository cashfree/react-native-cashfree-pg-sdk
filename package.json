{
  "name": "react-native-cashfree-pg-sdk",
  "version": "3.0.0",
  "description": "Cashfree PG Plugin for React Native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "react-native-cashfree-pg-sdk.podspec",
    "!lib/typescript/sampleApps",
    "!android/build",
    "!android/.gradle",
    "!android/.idea",
    "!ios/build",
    "!ios/.DS_Store",
    "!ios/CashfreePgApi.xcodeproj/xcuserdata",
    "!ios/CashfreePgApi.xcodeproj/project.xcworkspace/xcuserdata",
    "!ios/CashfreePgApi.xcodeproj/project.xcworkspace/xcshareddata",
    "!ios/CashfreePgApi.xcodeproj/project.xcworkspace/contents.xcworkspacedata",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "release": "release-it",
    "oldarch": "npm --prefix sampleApps/OldArchSample",
    "newarch": "npm --prefix sampleApps/NewArchSample",
    "expo": "npm --prefix sampleApps/ExpoSample",
    "pods:oldarch": "cd sampleApps/OldArchSample && pod-install --quiet",
    "pods:newarch": "cd sampleApps/NewArchSample && pod-install --quiet",
    "pods:expo": "cd sampleApps/ExpoSample && pod-install --quiet",
    "bootstrap": "yarn && npm --prefix sampleApps/OldArchSample install && npm --prefix sampleApps/NewArchSample install && npm --prefix sampleApps/ExpoSample install"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "cashfree",
    "react-native-android",
    "react-native-ios",
    "cashfree react-native sdk",
    "react-native payment gateway",
    "payment gateway",
    "react-native-cashfree-pg-sdk"
  ],
  "repository": "https://github.com/cashfree/react-native-cashfree-pg-sdk",
  "author": "cashfree-payments <developers@cashfree.com> (https://www.cashfree.com/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cashfree/react-native-cashfree-pg-sdk/issues"
  },
  "homepage": "https://docs.cashfree.com/docs/react-native-integration",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "codegenConfig": {
    "name": "RNCashfreePgApiSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.reactnativecashfreepgsdk"
    }
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^11.0.0",
    "@react-native-community/eslint-config": "^2.0.0",
    "@react-native/babel-preset": "^0.73.18",
    "@release-it/conventional-changelog": "^2.0.0",
    "@types/jest": "^26.0.0",
    "@types/node": "^18.0.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "commitlint": "^11.0.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^7.0.0",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^6.0.0",
    "jest": "^29.6.3",
    "pod-install": "^0.1.0",
    "prettier": "2.8.8",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-builder-bob": "^0.18.0",
    "release-it": "^14.2.2",
    "typescript": "^4.1.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.73.0"
  },
  "jest": {
    "preset": "react-native",
    "testPathIgnorePatterns": [
      "<rootDir>/sampleApps/",
      "<rootDir>/lib/",
      "<rootDir>/node_modules/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/sampleApps/OldArchSample/node_modules",
      "<rootDir>/sampleApps/NewArchSample/node_modules",
      "<rootDir>/sampleApps/ExpoSample/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "cashfree-pg-api-contract": "2.2.0"
  }
}
